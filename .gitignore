# Anypoint Studio workspace internals (not part of your code)
.metadata/
.tooling/
.tooling-apps-cache/
.mule/

# Build output
**/target/
**/.mule/

# Studio / Eclipse project files (regenerated when the project is imported)
#**/.classpath
#**/.project
#**/.settings/

# Secrets: never commit these
**/*.jks
**/*.p12
**/*.pfx
**/*key*.txt
*.env

# Runtime data created by the app
#data/output/
#data/error/

# Submission and recordings
#submit/
*.zip
*.mp4

# OS files
Thumbs.db
.DS_Store