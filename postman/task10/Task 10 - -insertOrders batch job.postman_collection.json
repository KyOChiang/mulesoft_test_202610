      "name": "T10-01 Submit 3-row file",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));\nconst j = pm.response.json();\npm.test(\"message\", () => pm.expect(j.message).to.eql(\"Batch job submitted\"));\npm.test(\"job id\", () => pm.expect(j.batchJobId).to.be.a(\"string\").and.not.empty);\npm.test(\"fast (async)\", () => pm.expect(pm.response.responseTime).to.be.below(5000));\npm.collectionVariables.set(\"t10_lastJobId\", j.batchJobId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/integration/insertOrders?filename=orders.csv",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "integration",
            "insertOrders"
          ],
          "query": [
            {
              "key": "filename",
              "value": "orders.csv"
            }
          ]
        },
        "description": "File: orders.csv. Reset tables first."
      },
      "response": []
