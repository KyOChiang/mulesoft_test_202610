      "name": "TC01 - Happy path JSON (full response)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response has valid JSON structure\", function () {\n    pm.response.to.be.json;\n});\n\npm.test(\"Response contains expected customer data\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.fullName).to.eql(\"Jane Doe\");\n    pm.expect(jsonData.customerId).to.eql(\"FC201CORP\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
