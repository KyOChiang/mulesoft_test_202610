    {
      "name": "TC02 - Happy path XML",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Content-Type is XML\", function () {\n    pm.response.to.have.header(\"Content-Type\");\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"xml\");\n});\n\nconst responseBody = pm.response.text();\n\npm.test(\"fullName\", function () {\n    pm.expect(responseBody).to.include(\"<customer:fullName>Jane Doe</customer:fullName>\");\n});\n\npm.test(\"fullAddress\", function () {\n    pm.expect(responseBody).to.include(\"<customer:fullAddress>Bangsar, Kuala Lumpur, 59100</customer:fullAddress>\");\n});\n\npm.test(\"orgnFormRefId-1\", function () {\n    pm.expect(responseBody).to.include(\"<customer:orgnFormRefId-1>45</customer:orgnFormRefId-1>\");\n});\n\npm.test(\"originationType-1\", function () {\n    pm.expect(responseBody).to.include(\"<customer:originationType-1>CORPORATE</customer:originationType-1>\");\n});\n\npm.test(\"customerType-1\", function () {\n    pm.expect(responseBody).to.include(\"<customer:customerType-1>Female</customer:customerType-1>\");\n});\n\npm.test(\"sourcePartyAcct\", function () {\n    pm.expect(responseBody).to.include(\"<customer:sourcePartyAcct>C201-OWNER</customer:sourcePartyAcct>\");\n});\n\npm.test(\"customerId\", function () {\n    pm.expect(responseBody).to.include(\"<customer:customerId>FC201CORP</customer:customerId>\");\n});\n\npm.test(\"totalOrders\", function () {\n    pm.expect(responseBody).to.include(\"<customer:totalOrders>2</customer:totalOrders>\");\n});\n\npm.test(\"totalAmounts\", function () {\n    pm.expect(responseBody).to.include(\"<customer:totalAmounts>300</customer:totalAmounts>\");\n});\n"
            ]
          }
        }
      ],
