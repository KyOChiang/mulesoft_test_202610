          "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"address\": \"Bangsar, Kuala Lumpur\",\n  \"poscode\": \"59100\",\n  \"orgnFormRefId\": 45.678,\n  \"originationType\": \"CORP\",\n  \"customerType\": \"F\",\n  \"sourceSystemId\": \"C201\",\n  \"partyAcctRelationship\": \"OWNER\",\n  \"orders\": [\n    {\n      \"orderId\": \"A01\",\n      \"amount\": 200\n    },\n    {\n      \"orderId\": \"A02\",\n      \"amount\": 100\n    }\n  ],\n  \"responseType\": \"JSON\"\n}",
