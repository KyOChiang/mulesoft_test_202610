            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response has valid JSON structure\", function () {\n    pm.response.to.be.json;\n    const jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property('fullName');\n    pm.expect(jsonData).to.have.property('customerId');\n});\n\npm.test(\"Verify customer details\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.fullName).to.eql(\"Jane Doe\");\n    pm.expect(jsonData.originationType_1).to.not.exist; // Checking for correct key name\n    pm.expect(jsonData[\"originationType-1\"]).to.eql(\"INDIVIDUAL\");\n    pm.expect(jsonData.customerType_1).to.not.exist;\n    pm.expect(jsonData[\"customerType-1\"]).to.eql(\"Female\");\n});"
