{
  "info": {
    "_postman_id": "cde91162-1a90-4b3e-a1b5-3f5fb82e3297",
    "name": "Task 11 - /recordsBackend reliability",
    "description": "A = idempotency, B = retry, C = circuit breaker. B and C need a broken backend (see task11-recordsBackend-reliability.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "50632837",
    "_collection_link": "https://go.postman.co/collection/50632837-cde91162-1a90-4b3e-a1b5-3f5fb82e3297?source=collection_link"
  },
  "item": [
    {
      "name": "A Idempotency",
      "item": [
        {
          "name": "T11-A1 First call hits the backend",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));\npm.test(\"mapped keys\", () => [\"User Id\",\"Full Name\",\"The Tier\",\"Tax Applied\",\"Total Tax\",\"Date\"].forEach(k => pm.expect(pm.response.json()).to.have.property(k)));\npm.collectionVariables.set(\"t11_first\", pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"User Id\": {{uid}},\n  \"First Name\": \"Will\",\n  \"Last Name\": \"Smith\",\n  \"Current Salary\": 1200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/integration/recordsBackend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "integration",
                "recordsBackend"
              ]
            }
          },
          "response": []
        },
        {
          "name": "T11-A2 Same User Id returns the cached response",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 (not 409)\", () => pm.response.to.have.status(200));\npm.test(\"identical to first\", () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get(\"t11_first\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"User Id\": {{uid}},\n  \"First Name\": \"Will\",\n  \"Last Name\": \"Smith\",\n  \"Current Salary\": 1200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/integration/recordsBackend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "integration",
                "recordsBackend"
              ]
            },
            "description": "Within 10 minutes of T11-A1. Log shows Idempotent replay and no backend call."
          },
          "response": []
        },
        {
          "name": "T11-A4 Different User Id is a fresh call",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"User Id\": {{$randomInt}},\n  \"First Name\": \"Will\",\n  \"Last Name\": \"Smith\",\n  \"Current Salary\": 1200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/integration/recordsBackend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "integration",
                "recordsBackend"
              ]
            }
          },
          "response": []
        },
        {
          "name": "T11-A5 Missing field returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));\npm.test(\"error shape {error,message}\", () => pm.expect(pm.response.json()).to.have.keys(\"error\",\"message\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
