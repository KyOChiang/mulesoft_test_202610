    },
    {
      "name": "B Retry (backend broken)",
      "item": [
        {
          "name": "T11-B1 Retry 1s+2s+4s then 502",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"uid_fail\", Math.floor(Date.now() / 1000) % 1000000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"502\", () => pm.response.to.have.status(502));\npm.test(\"error\", () => pm.expect(pm.response.json().error).to.eql(\"Backend call failed\"));\npm.test(\"took about 7s\", () => pm.expect(pm.response.responseTime).to.be.within(6500, 12000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"User Id\": {{uid_fail}},\n  \"First Name\": \"Will\",\n  \"Last Name\": \"Smith\",\n  \"Current Salary\": 1200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/integration/recordsBackend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "integration",
                "recordsBackend"
              ]
            },
            "description": "Set backend.host to an unreachable host and redeploy. Console: Backend attempt 1/2/3 failed."
          },
          "response": []
        }
      ]
    },
    {
      "name": "C Circuit breaker (backend broken)",
      "item": [
        {
          "name": "T11-C4 Circuit open returns 503 fast",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"uid_fail\", Math.floor(Date.now() / 1000) % 1000000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"503\", () => pm.response.to.have.status(503));\npm.test(\"body\", () => pm.expect(pm.response.json()).to.eql({ error: \"Service temporarily unavailable. Please try again later.\" }));\npm.test(\"fails fast\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"User Id\": {{uid_fail}},\n  \"First Name\": \"Will\",\n  \"Last Name\": \"Smith\",\n  \"Current Salary\": 1200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/integration/recordsBackend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "integration",
                "recordsBackend"
              ]
            },
            "description": "Send 3 failing requests first (T11-B1 three times with new ids), then this one immediately."
          },
          "response": []
        },
        {
          "name": "T11-C7 Probe after fix closes the circuit",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"uid_fail\", Math.floor(Date.now() / 1000) % 1000000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));\npm.test(\"mapped\", () => pm.expect(pm.response.json()).to.have.property(\"Full Name\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"User Id\": {{uid_fail}},\n  \"First Name\": \"Will\",\n  \"Last Name\": \"Smith\",\n  \"Current Salary\": 1200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/integration/recordsBackend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "integration",
                "recordsBackend"
              ]
            },
            "description": "Fix backend.host, redeploy, wait until 60 s after the circuit opened, then send."
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"uid\")) pm.collectionVariables.set(\"uid\", Math.floor(Date.now() / 1000) % 1000000);"
        ]
      }
    }
  ],
