              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"User Id\": 9001,\n  \"First Name\": \"Will\",\n  \"Current Salary\": 1200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/integration/recordsBackend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
