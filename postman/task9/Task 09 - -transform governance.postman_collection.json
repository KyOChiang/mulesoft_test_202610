          "name": "T9-B1 First call is MISS",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"t9_key\", \"CACHE-\" + Date.now());\npm.collectionVariables.set(\"t9_body\", JSON.stringify(Object.assign({\"firstName\": \"Jane\", \"lastName\": \"Doe\", \"address\": \"Bangsar, Kuala Lumpur\", \"poscode\": \"59100\", \"orgnFormRefId\": 45.678, \"originationType\": \"CORP\", \"customerType\": \"F\", \"sourceSystemId\": \"C201\", \"partyAcctRelationship\": \"OWNER\", \"orders\": [{\"orderId\": \"A01\", \"amount\": 200}, {\"orderId\": \"A02\", \"amount\": 100}], \"responseType\": \"JSON\"}, { sourceSystemId: pm.collectionVariables.get(\"t9_key\") })));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"MISS\", () => pm.response.to.have.header(\"X-Cache\", \"MISS\"));\npm.test(\"200\", () => pm.response.to.have.status(200));\npm.collectionVariables.set(\"t9_processedAt\", pm.response.json().metadata.processedAt);"
                ]
              }
            }
