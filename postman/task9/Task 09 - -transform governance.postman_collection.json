    {
      "name": "C Rate limit",
      "item": [
        {
          "name": "T9-C1 Burst (Collection Runner, 4 iterations, delay 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const it = pm.info.iteration + 1;\nif (it <= 3) {\n  pm.test(\"allowed #\" + it, () => pm.response.to.have.status(200));\n} else {\n  pm.test(\"429 on #\" + it, () => pm.response.to.have.status(429));\n  pm.test(\"body\", () => pm.expect(pm.response.json()).to.eql({ error: \"Rate limit exceeded\", retryAfter: 60 }));\n  pm.test(\"Retry-After header\", () => pm.response.to.have.header(\"Retry-After\", \"60\"));\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"address\": \"Bangsar, Kuala Lumpur\",\n  \"poscode\": \"59100\",\n  \"orgnFormRefId\": 45.678,\n  \"originationType\": \"CORP\",\n  \"customerType\": \"F\",\n  \"sourceSystemId\": \"RATE\",\n  \"partyAcctRelationship\": \"OWNER\",\n  \"orders\": [\n    {\n      \"orderId\": \"A01\",\n      \"amount\": 200\n    },\n    {\n      \"orderId\": \"A02\",\n      \"amount\": 100\n    }\n  ],\n  \"responseType\": \"JSON\"\n}",
              "options": {
